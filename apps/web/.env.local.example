# Copy to .env.local for local dev. Never commit the populated file.

# URL of the FastAPI backend. Server-side only — never read from the client.
API_URL=http://localhost:8000

# API key for the FastAPI backend (BRD-01 §3.7 MTC-07).
# Server-side only — never prefix with NEXT_PUBLIC_.
# In production, set this in the Vercel dashboard, not in the repo.
API_KEY=dev-local-key-change-me
