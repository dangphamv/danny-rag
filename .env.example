# Copy to .env for local dev. Never commit the populated file.

# --- LLM provider keys ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Provider selection ---
LLM_PROVIDER=anthropic            # anthropic | openai | ollama
EMBED_PROVIDER=openai             # openai | ollama

# --- Vector store ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                   # leave empty for local Docker Qdrant

# --- Observability (Langfuse v3 self-hosted) ---
# These match docker-compose.yml LANGFUSE_INIT_* values for local dev.
LANGFUSE_PUBLIC_KEY=pk-lf-dev-public
LANGFUSE_SECRET_KEY=sk-lf-dev-secret
LANGFUSE_HOST=http://localhost:3001

# --- Postgres (shared by Langfuse + LangGraph checkpointer) ---
# Same instance as Langfuse Postgres. ClickHouse holds traces; this DB is for
# Langfuse metadata + the LangGraph checkpointer tables (separately namespaced).
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/postgres

# --- API auth (MTC-07) ---
API_KEY=dev-local-key-change-me

# --- CORS allowlist (MTC-06) ---
# Comma-separated. No "*". Add Vercel prod + preview URLs in prod.
ALLOWED_ORIGINS=http://localhost:3000

# --- Ollama (optional, local experiments) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Ingest enrichment (ADR-0011, opt-in) ---
# When true, each chunk is passed through the chat LLM before embedding to
# generate a summary, hypothetical questions, keywords, entities, and a cleaned
# text variant. The enriched text is embedded; the raw chunk is still stored
# for citation display. Uses LLM_PROVIDER. Adds ~1 LLM call per new chunk.
INGEST_ENRICH=false
INGEST_ENRICH_VERSION=v1          # bump to force re-enrichment of existing chunks
INGEST_ENRICH_CONCURRENCY=5
INGEST_ENRICH_MAX_TOKENS=1024     # ≤ MTC-10 ceiling (1024)

# --- Environment tag for traces ---
ENV=local
